+// llama_ple_direct_reader
+
+struct llama_ple_direct_reader::impl {
+    static constexpr size_t CHUNK_REQS = 512;
+    static constexpr size_t MAX_SLOTS  = CHUNK_REQS * 2;
+    static constexpr size_t N_WORKERS  = 8;
+
+    struct io_run {
+        uint64_t file_off;
+        size_t   buf_off;
+        size_t   byte_len;
+    };
+
+    std::string fname;
+    size_t      data_offset = 0;
+    size_t      file_size   = 0;
+    ggml_type   row_type    = GGML_TYPE_F32;
+    int64_t     n_cols      = 0;
+    int64_t     n_rows      = 0;
+    size_t      row_bytes   = 0;
+    size_t      align_bytes = 4096;
+    bool        no_alloc    = false;
+    bool        unbuffered  = false;
+
+    const ggml_type_traits * traits = nullptr;
+
+#if defined(_WIN32)
+    HANDLE hFile = INVALID_HANDLE_VALUE;
+#else
+    int fd = -1;
+#endif
+
+    uint8_t * dma_buf = nullptr;
+
+    mutable std::mutex              call_mtx;
+    mutable std::vector<uint64_t>   needed_blks;
+    mutable std::vector<io_run>     runs;
+
+    mutable std::mutex              pool_mtx;
+    mutable std::condition_variable cv_start;
+    mutable std::condition_variable cv_done;
+    mutable std::vector<std::thread> workers;
+    mutable std::atomic<size_t>     next_run{0};
+    mutable size_t                  active_workers = 0;
+    mutable uint64_t                epoch          = 0;
+    mutable bool                    stop_pool      = false;
+    mutable std::string             worker_err;
+
+    impl(const char * fname_in, size_t offset_in, ggml_type type_in, int64_t cols_in, int64_t rows_in, bool no_alloc_in)
+        : fname(fname_in ? fname_in : ""),
+          data_offset(offset_in),
+          row_type(type_in),
+          n_cols(cols_in),
+          n_rows(rows_in),
+          row_bytes(ggml_row_size(type_in, cols_in)),
+          no_alloc(no_alloc_in),
+          traits(ggml_get_type_traits(type_in)) {
+        if (!traits || !traits->to_float) {
+            throw std::runtime_error(format("llama_ple_direct_reader: unsupported type %s", ggml_type_name(row_type)));
+        }
+        if (no_alloc) {
+            return;
+        }
+        if (fname.empty() || fname == "(file*)") {
+            throw std::runtime_error("llama_ple_direct_reader requires a file path");
+        }
+
+#if defined(_WIN32)
+        int wlen = MultiByteToWideChar(CP_UTF8, 0, fname.c_str(), -1, nullptr, 0);
+        std::wstring wpath(wlen > 0 ? wlen : 1, L'\0');
+        if (wlen > 0) {
+            MultiByteToWideChar(CP_UTF8, 0, fname.c_str(), -1, wpath.data(), wlen);
+        }
+        hFile = CreateFileW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                            OPEN_EXISTING, FILE_FLAG_NO_BUFFERING | FILE_FLAG_RANDOM_ACCESS, nullptr);
+        if (hFile != INVALID_HANDLE_VALUE) {
+            unbuffered = true;
+        } else {
+            hFile = CreateFileW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                                OPEN_EXISTING, FILE_FLAG_RANDOM_ACCESS, nullptr);
+            if (hFile == INVALID_HANDLE_VALUE) {
+                throw std::runtime_error(format("llama_ple_direct_reader: CreateFileW failed for '%s'", fname.c_str()));
+            }
+        }
+        LARGE_INTEGER li_sz{};
+        if (!GetFileSizeEx(hFile, &li_sz)) {
+            CloseHandle(hFile);
+            hFile = INVALID_HANDLE_VALUE;
+            throw std::runtime_error("llama_ple_direct_reader: GetFileSizeEx failed");
+        }
+        file_size = (size_t) li_sz.QuadPart;
+        align_bytes = 4096;
+        dma_buf = static_cast<uint8_t *>(_aligned_malloc(MAX_SLOTS * align_bytes, align_bytes));
+        if (!dma_buf) {
+            CloseHandle(hFile);
+            hFile = INVALID_HANDLE_VALUE;
+            throw std::runtime_error("llama_ple_direct_reader: _aligned_malloc failed");
+        }
+#else
+#if defined(__linux__) && defined(O_DIRECT)
+        fd = ::open(fname.c_str(), O_RDONLY | O_DIRECT | O_CLOEXEC);
+        if (fd != -1) {
+            unbuffered = true;
+        }
+#endif
+        if (fd == -1) {
+            fd = ::open(fname.c_str(), O_RDONLY | O_CLOEXEC);
+            if (fd == -1) {
+                throw std::runtime_error(format("llama_ple_direct_reader: open('%s') failed: %s", fname.c_str(), strerror(errno)));
+            }
+            unbuffered = false;
+        }
+
+        struct stat st{};
+        if (::fstat(fd, &st) != 0) {
+            ::close(fd);
+            fd = -1;
+            throw std::runtime_error(format("llama_ple_direct_reader: fstat failed: %s", strerror(errno)));
+        }
+        file_size = (size_t) st.st_size;
+        size_t blk = st.st_blksize > 0 ? (size_t) st.st_blksize : 4096;
+        align_bytes = 4096;
+        while (align_bytes < blk) {
+            align_bytes <<= 1;
+        }
+
+        void * raw = nullptr;
+        if (posix_memalign(&raw, align_bytes, MAX_SLOTS * align_bytes) != 0 || !raw) {
+            ::close(fd);
+            fd = -1;
+            throw std::runtime_error("llama_ple_direct_reader: posix_memalign failed");
+        }
+        dma_buf = static_cast<uint8_t *>(raw);
+
+#if defined(__linux__)
+        if (unbuffered) {
+            const uint64_t probe_off = (uint64_t) data_offset & ~((uint64_t) align_bytes - 1);
+            const ssize_t pr = ::pread(fd, dma_buf, align_bytes, (off_t) probe_off);
+            if (pr < 0 && (errno == EINVAL || errno == EOPNOTSUPP)) {
+                ::close(fd);
+                fd = ::open(fname.c_str(), O_RDONLY | O_CLOEXEC);
+                if (fd == -1) {
+                    free(dma_buf);
+                    dma_buf = nullptr;
+                    throw std::runtime_error(format("llama_ple_direct_reader: fallback open failed: %s", strerror(errno)));
+                }
+                unbuffered = false;
+            }
+        }
+        if (!unbuffered) {
+            (void) posix_fadvise(fd, (off_t) data_offset, (off_t) (row_bytes * (size_t) n_rows), POSIX_FADV_RANDOM);
+        }
+#endif
+#endif
+
+        needed_blks.reserve(MAX_SLOTS);
+        runs.reserve(MAX_SLOTS);
+
+        workers.reserve(N_WORKERS);
+        for (size_t w = 0; w < N_WORKERS; ++w) {
+            workers.emplace_back([this]() { worker_loop(); });
+        }
+
+        LLAMA_LOG_INFO("[PLE-DIRECT] opened '%s' (offset=%zu, rows=%lld, row_bytes=%zu, align=%zu, unbuffered=%d, 0 B mmap RSS)\n",
+                       fname.c_str(), data_offset, (long long) n_rows, row_bytes, align_bytes, (int) unbuffered);
+    }
+
+    ~impl() {
+        if (!workers.empty()) {
+            {
+                std::lock_guard<std::mutex> lk(pool_mtx);
+                stop_pool = true;
+                epoch++;
+            }
+            cv_start.notify_all();
+            for (auto & th : workers) {
+                if (th.joinable()) {
+                    th.join();
+                }
+            }
+        }
+#if defined(_WIN32)
+        if (dma_buf) {
+            _aligned_free(dma_buf);
+            dma_buf = nullptr;
+        }
+        if (hFile != INVALID_HANDLE_VALUE) {
+            CloseHandle(hFile);
+            hFile = INVALID_HANDLE_VALUE;
+        }
+#else
+        if (dma_buf) {
+            free(dma_buf);
+            dma_buf = nullptr;
+        }
+        if (fd != -1) {
+            ::close(fd);
+            fd = -1;
+        }
+#endif
+    }
+
+    void exec_run(const io_run & r) const {
+#if defined(_WIN32)
+        OVERLAPPED ov{};
+        ov.Offset     = (DWORD) (r.file_off & 0xffffffffull);
+        ov.OffsetHigh = (DWORD) (r.file_off >> 32);
+        DWORD got = 0;
+        if (!ReadFile(hFile, dma_buf + r.buf_off, (DWORD) r.byte_len, &got, &ov)) {
+            throw std::runtime_error(format("llama_ple_direct_reader: ReadFile failed (%lu)", (unsigned long) GetLastError()));
+        }
+        if (got < r.byte_len) {
+            std::memset(dma_buf + r.buf_off + got, 0, r.byte_len - got);
+        }
+#else
+        size_t done = 0;
+        while (done < r.byte_len) {
+            const ssize_t ret = ::pread(fd, dma_buf + r.buf_off + done, r.byte_len - done, (off_t) (r.file_off + done));
+            if (ret < 0) {
+                if (errno == EINTR) {
+                    continue;
+                }
+                throw std::runtime_error(format("llama_ple_direct_reader: pread failed at %llu: %s",
+                                                (unsigned long long) (r.file_off + done), strerror(errno)));
+            }
+            if (ret == 0) {
+                std::memset(dma_buf + r.buf_off + done, 0, r.byte_len - done);
+                break;
+            }
+            done += (size_t) ret;
+        }
+#if defined(__linux__)
+        if (!unbuffered) {
+            (void) posix_fadvise(fd, (off_t) r.file_off, (off_t) r.byte_len, POSIX_FADV_DONTNEED);
+        }
+#endif
+#endif
+    }
+
+    void worker_loop() const {
+        uint64_t seen_epoch = 0;
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lk(pool_mtx);
+                cv_start.wait(lk, [&]() { return stop_pool || epoch != seen_epoch; });
+                if (stop_pool) {
+                    return;
+                }
+                seen_epoch = epoch;
+            }
+
+            for (;;) {
+                const size_t idx = next_run.fetch_add(1, std::memory_order_relaxed);
+                if (idx >= runs.size()) {
+                    break;
+                }
+                try {
+                    exec_run(runs[idx]);
+                } catch (const std::exception & e) {
+                    std::lock_guard<std::mutex> lk(pool_mtx);
+                    if (worker_err.empty()) {
+                        worker_err = e.what();
+                    }
+                }
+            }
+
+            {
+                std::lock_guard<std::mutex> lk(pool_mtx);
+                if (--active_workers == 0) {
+                    cv_done.notify_one();
+                }
+            }
+        }
+    }
+
+    void gather_rows_f32(const int32_t * row_ids, size_t n_req, float * dst_f32) const {
+        if (n_req == 0 || no_alloc) {
+            return;
+        }
+        std::lock_guard<std::mutex> lk(call_mtx);
+
+        for (size_t base = 0; base < n_req; base += CHUNK_REQS) {
+            const size_t chunk_n = std::min(CHUNK_REQS, n_req - base);
+            needed_blks.clear();
+
+            for (size_t k = 0; k < chunk_n; ++k) {
+                const int32_t r = row_ids[base + k];
+                GGML_ASSERT(r >= 0 && r < n_rows);
+                const uint64_t byte_off = (uint64_t) data_offset + (uint64_t) r * row_bytes;
+                const uint64_t blk0     = byte_off / align_bytes;
+                const uint64_t blk1     = (byte_off + row_bytes - 1) / align_bytes;
+                needed_blks.push_back(blk0);
+                if (blk1 != blk0) {
+                    needed_blks.push_back(blk1);
+                }
+            }
+
+            std::sort(needed_blks.begin(), needed_blks.end());
+            needed_blks.erase(std::unique(needed_blks.begin(), needed_blks.end()), needed_blks.end());
+            GGML_ASSERT(needed_blks.size() <= MAX_SLOTS);
+
+            runs.clear();
+            for (size_t s = 0; s < needed_blks.size(); ) {
+                size_t m = 1;
+                while (s + m < needed_blks.size() && m < 16 && needed_blks[s + m] == needed_blks[s] + m) {
+                    ++m;
+                }
+                runs.push_back({
+                    /* .file_off = */ needed_blks[s] * (uint64_t) align_bytes,
+                    /* .buf_off  = */ s * align_bytes,
+                    /* .byte_len = */ m * align_bytes,
+                });
+                s += m;
+            }
+
+            if (runs.size() <= 2 || workers.empty()) {
+                for (const auto & r : runs) {
+                    exec_run(r);
+                }
+            } else {
+                {
+                    std::lock_guard<std::mutex> plk(pool_mtx);
+                    next_run.store(0, std::memory_order_relaxed);
+                    active_workers = workers.size();
+                    worker_err.clear();
+                    epoch++;
+                }
+                cv_start.notify_all();
+                {
+                    std::unique_lock<std::mutex> plk(pool_mtx);
+                    cv_done.wait(plk, [&]() { return active_workers == 0; });
+                    if (!worker_err.empty()) {
+                        throw std::runtime_error(worker_err);
+                    }
+                }
+            }
+
+            for (size_t k = 0; k < chunk_n; ++k) {
+                const int32_t  r        = row_ids[base + k];
+                const uint64_t byte_off = (uint64_t) data_offset + (uint64_t) r * row_bytes;
+                const uint64_t blk0     = byte_off / align_bytes;
+                const uint64_t blk1     = (byte_off + row_bytes - 1) / align_bytes;
+                const auto     it       = std::lower_bound(needed_blks.begin(), needed_blks.end(), blk0);
+                const size_t   s0       = (size_t) (it - needed_blks.begin());
+                GGML_ASSERT(blk1 == blk0 || (s0 + 1 < needed_blks.size() && needed_blks[s0 + 1] == blk1));
+
+                const size_t    in_blk  = (size_t) (byte_off - blk0 * align_bytes);
+                const uint8_t * row_ptr = dma_buf + s0 * align_bytes + in_blk;
+                traits->to_float(row_ptr, dst_f32 + (base + k) * (size_t) n_cols, n_cols);
+            }
+        }
+    }
+};
+
+llama_ple_direct_reader::llama_ple_direct_reader(
+        const char * fname,
+        size_t       data_offset,
+        ggml_type    row_type,
+        int64_t      n_cols,
+        int64_t      n_rows,
+        bool         no_alloc)
+    : pimpl(std::make_unique<impl>(fname, data_offset, row_type, n_cols, n_rows, no_alloc)) {}
+
+llama_ple_direct_reader::~llama_ple_direct_reader() = default;
+
+void llama_ple_direct_reader::gather_rows_f32(const int32_t * row_ids, size_t n_req, float * dst_f32) const {
+    pimpl->gather_rows_f32(row_ids, n_req, dst_f32);
+}
+
+size_t llama_ple_direct_reader::nbytes() const {
+    return pimpl->row_bytes * (size_t) pimpl->n_rows;
+}
