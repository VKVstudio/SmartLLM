#!/usr/bin/env bash
# SmartLLM Studio v0.0.1-beta — Linux Executable Launcher (127.0.0.1 only)
set -euo pipefail

STUDIO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "${STUDIO_DIR}/.." && pwd)"

PYTHON_BIN="${REPO_ROOT}/.venv_linux/bin/python"
if [[ ! -x "${PYTHON_BIN}" ]]; then
    PYTHON_BIN="/usr/bin/python3"
fi

export PYTHONPATH="${STUDIO_DIR}:${REPO_ROOT}/tools/llama.cpp/gguf-py:${REPO_ROOT}:${PYTHONPATH:-}"
exec "${PYTHON_BIN}" -m smartllm_studio.cli "$@"
